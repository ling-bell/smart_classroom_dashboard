# 请将下面的占位符替换为你自己的 DashScope API Key
# 获取方式：https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY="your_dashscope_api_key_here"

# --- YOLO 模型与推理参数（可选，全部有默认值，见 model_config.py）---
# 指向微调后的权重即可生效，无需改代码
# YOLO_DETECT_MODEL="yolo11s.pt"
# YOLO_POSE_MODEL="yolo11s-pose.pt"
# 课堂后排小目标：建议训练与推理都用 960/1280，需保持一致
# YOLO_IMGSZ=640
# 漏检多就调低，误检多就调高
# YOLO_CONF=0.25
# YOLO_POSE_CONF=0.20
# YOLO_IOU=0.45
# YOLO_MAX_DET=100
# 视频抽帧率（每秒参与行为分析的帧数），调高可减少时序漏检
# YOLO_SAMPLING_RATE=0.5